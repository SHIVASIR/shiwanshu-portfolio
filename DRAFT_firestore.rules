rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'shiwanshusingh153@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Entity Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt', 'lastLoginAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'role', 'bio', 'starredProjects', 'createdAt', 'lastLoginAt']) &&
             data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('role' in data) || (data.role in ['visitor', 'recruiter', 'developer', 'collaborator', 'admin'])) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('starredProjects' in data) || (data.starredProjects is list && data.starredProjects.size() <= 50));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'email', 'message', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'email', 'message', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 100 &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 3000 &&
             data.status in ['sent', 'read', 'replied'];
    }

    function isValidProjectLike(data, projectId) {
      return data.keys().hasAll(['projectId', 'userId', 'userDisplayName', 'createdAt']) &&
             data.keys().hasOnly(['projectId', 'userId', 'userDisplayName', 'createdAt']) &&
             data.projectId is string && data.projectId == projectId && data.projectId.size() <= 64 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userDisplayName is string && data.userDisplayName.size() <= 100;
    }

    function isValidGuestbookEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'message', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'userName', 'userPhoto', 'userEmail', 'message', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 500)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 100)) &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 500;
    }

    // --- Collection Rules ---

    // 1. User Profiles: PII protected, only self or admin read/write
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().lastLoginAt == request.time;
      allow update: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin()) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().lastLoginAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'bio', 'starredProjects', 'lastLoginAt']);
      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // 2. Messages sent by this user
      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isVerified() && isValidId(userId) && isValidId(messageId) && isOwner(userId) &&
                         isValidMessage(incoming()) &&
                         incoming().userId == userId &&
                         incoming().createdAt == request.time;
        allow update: if isAdmin() && isValidId(userId) && isValidId(messageId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if isVerified() && isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
      }
    }

    // 3. Project Likes
    match /projects/{projectId}/likes/{userId} {
      allow get, list: if isValidId(projectId);
      allow create: if isVerified() && isValidId(projectId) && isValidId(userId) && isOwner(userId) &&
                       isValidProjectLike(incoming(), projectId) &&
                       incoming().createdAt == request.time;
      allow delete: if isVerified() && isValidId(projectId) && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow update: if false;
    }

    // 4. Guestbook Entries & Endorsements
    match /guestbook/{entryId} {
      allow get, list: if true;
      allow create: if isVerified() && isValidId(entryId) &&
                       isValidGuestbookEntry(incoming()) &&
                       incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerified() && isValidId(entryId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
